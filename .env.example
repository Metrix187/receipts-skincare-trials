# Copy to .env (or run `npm run setup`, which does it for you and fills in secrets).
# .env is gitignored. Never commit real keys.

# --- Database -------------------------------------------------------------
# Local dev: SQLite file. Vercel/Neon: a postgres:// URL (see README "Deploying").
DATABASE_URL="file:./dev.db"

# --- YouCam API -----------------------------------------------------------
# Console: https://yce.perfectcorp.com/api-console  (v2 auth = Bearer API key)
YOUCAM_API_KEY=
# 1 = never call YouCam; return realistic fixtures and log 0-unit ledger rows.
# Set to 0 only when you intend to spend real units.
MOCK_YOUCAM=1
# sd (9 units per call for 1-4 concerns, short side >= 480px)
# hd (12 units per call for 1-4 concerns, short side >= 1080px)
YOUCAM_TIER=sd
# Hard stop: refuse to submit a real task once the ledger shows this many units charged.
YOUCAM_UNIT_BUDGET=600

# --- Anthropic (Protocol + Verdict agents) ---------------------------------
# Leave blank to run the deterministic mock agents (same tools, templated prose).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (thinking is always on for Opus 5.5; effort controls depth)
ANTHROPIC_EFFORT=medium

# --- Privacy --------------------------------------------------------------
# 32 random bytes, base64. Encrypts selfies at rest (AES-256-GCM).
# `npm run setup` generates one. Losing it makes stored photos unreadable (scores survive).
PHOTO_ENCRYPTION_KEY=

# --- Client ---------------------------------------------------------------
# mediapipe = real in-browser face detector; mock = fixed centered box (tests only)
NEXT_PUBLIC_FACE_DETECTOR=mediapipe

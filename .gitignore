# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# local secrets that may sit next to the repo
youcamkey.env*
.mcp.json

# generated
/public/mediapipe/wasm
/prisma/*.db
/prisma/*.db-journal
/prisma/schema.postgres.prisma
/test-results
/playwright-report
/blob-report
tests/e2e/fixtures/
/prisma/e2e*.db*
/inspect-out
/deliverables/

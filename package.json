{
  "name": "receipts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "setup": "node scripts/setup-env.mjs && prisma db push && node scripts/copy-mediapipe.mjs",
    "postinstall": "prisma generate && node scripts/copy-mediapipe.mjs",
    "db:push": "prisma db push",
    "db:postgres": "node scripts/use-postgres.mjs",
    "seed:demo": "tsx --conditions=react-server --env-file=.env scripts/seed-demo.mts",
    "youcam:balance": "tsx --conditions=react-server --env-file=.env scripts/youcam-balance.mts",
    "inspect:capture": "tsx --conditions=react-server --env-file=.env scripts/inspect-capture.mts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "vercel-build": "node scripts/use-postgres.mjs && prisma generate && prisma db push --skip-generate && next build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@mediapipe/tasks-vision": "^1.1.0",
    "@prisma/client": "^6.19.3",
    "html-to-image": "^1.11.13",
    "next": "^16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true
  }
}
